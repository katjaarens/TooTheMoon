@{
    ViewData["Title"] = "Vielen Dank! – Andrea & Katja";
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ffffff;
            overflow-y: auto;
        }

        .thankyou-card {
            background: #111827;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 550px;
            padding: 50px 40px;
            margin: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
        }

        .heart-icon {
            font-size: 48px;
            margin-bottom: 20px;
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            margin: 0 0 15px 0;
            color: #ffffff;
        }

        .message {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 18px;
            color: #cbd5e1;
            line-height: 1.6;
            margin-bottom: 35px;
        }

        .btn-home {
            display: inline-block;
            background: #d4a373;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 500;
            padding: 12px 32px;
            border-radius: 30px;
            text-decoration: none;
            box-shadow: 0 4px 12px rgba(212, 163, 115, 0.4);
            transition: background 0.3s ease, transform 0.2s ease;
        }

        .btn-home:hover {
            background: #bc8a5d;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

    <div class="thankyou-card">
        <div class="heart-icon">❤️</div>
        <h1>Vielen Dank!</h1>
        <div class="message">
            Deine Rückmeldung wurde erfolgreich an uns übermittelt. Wir freuen uns schon riesig darauf, diesen besonderen Tag am 14. August 2027 mit dir/euch zu feiern!
        </div>

        <a href="/Home/Index" class="btn-home">Zurück zur Startseite</a>
    </div>

</body>
</html>