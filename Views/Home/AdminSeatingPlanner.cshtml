@model IEnumerable<TooTheMoon.Models.WeddingTable>

@{
    ViewData["Title"] = "Sitzplan verwalten";
    Layout = null; 
    var attendingGuests = ViewBag.AttendingGuests as List<TooTheMoon.Models.RsvpGuest> ?? new List<TooTheMoon.Models.RsvpGuest>();
    var unassignedGuests = attendingGuests.Where(g => g.WeddingTableId == null).ToList();
    
    int totalAttendingPersons = attendingGuests.Sum(g => g.NumberOfGuests);
    int totalCapacity = Model.Sum(t => t.Capacity);
    int totalAssignedPersons = Model.Sum(t => t.Guests?.Sum(g => g.NumberOfGuests) ?? 0);
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" />
    <style>
        .guest-item {
            cursor: grab;
            transition: transform 0.15s ease, background-color 0.15s ease;
        }
        .guest-item:active {
            cursor: grabbing;
        }
        .table-drop-zone {
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }
        .table-drop-zone.drag-over {
            background-color: rgba(244, 114, 182, 0.15) !important;
            border-color: #f472b6 !important;
        }
    </style>
</head>
<body style="background-color: #0b0f19; color: #fff; font-family: 'Inter', sans-serif; padding-bottom: 50px;">

    <header>
        <a href="/" class="logo">Andrea & Katja</a>
        <nav>
            <a href="/">Zur Startseite</a>
            <a href="/Home/AdminGuests">Gäste-Liste</a>
            <a href="/Home/AdminSeatingPlanner" style="color: #f472b6;">Sitzplan</a>
            <form asp-action="Logout" method="post" style="display:inline; margin-left: 15px;">
                <button type="submit" style="background:none; border:none; color:#f87171; cursor:pointer; font-size: 0.9rem;">Abmelden</button>
            </form>
        </nav>
    </header>

    <div class="container" style="max-width: 1200px; margin: 100px auto 0 auto; padding: 0 20px;">
        
        <div class="glass-panel" style="padding: 40px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; backdrop-filter: blur(12px);">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px; margin-bottom: 25px;">
                <div>
                    <h2 style="font-family: 'Playfair Display', serif; font-size: 2rem; color: #fff; margin-bottom: 5px;">Sitzplan verwalten</h2>
                    <div style="color: #f472b6; font-size: 0.95rem;">Zieh die Gäste per Drag & Drop auf die Tische oder nutze die Dropdowns.</div>
                </div>
                <!-- Statistik-Badges -->
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); padding: 8px 14px; border-radius: 10px; font-size: 0.85rem;">
                        Zugs.: <strong style="color: #f472b6;">@totalAssignedPersons / @totalAttendingPersons</strong> P.
                    </div>
                    <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); padding: 8px 14px; border-radius: 10px; font-size: 0.85rem;">
                        Gesamtkapazität: <strong style="color: #fff;">@totalCapacity</strong> P.
                    </div>
                </div>
            </div>
            <hr style="border-color: rgba(255,255,255,0.1); margin-bottom: 30px;" />

            <!-- Raum- & Saalplan Grafik -->
            <div style="margin-bottom: 40px; text-align: center;">
                <h3 style="font-family: 'Playfair Display', serif; font-size: 1.3rem; color: #fff; margin-bottom: 12px;">Sprikeltrix – Raum- & Saalplan</h3>
                <div style="background: rgba(255, 255, 255, 0.02); padding: 15px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.08); display: inline-block; max-width: 100%;">
                    <img src="~/images/saalplan.svg" alt="Saalplan Übersicht" style="max-width: 100%; height: auto; border-radius: 10px; display: block; margin: 0 auto;" onerror="this.style.display='none'; document.getElementById('no-plan-text').style.display='block';" />
                    <p id="no-plan-text" style="display: none; color: #94a3b8; font-size: 0.9rem; margin: 10px 0;">(Noch kein Saalplan-Bild unter <code>wwwroot/images/saalplan.svg</code> hinterlegt)</p>
                </div>
            </div>

            <!-- Tische & Gäste Grid -->
            <div class="row" style="display: flex; flex-wrap: wrap; gap: 30px;">
                
                <!-- Linke Spalte: Unzugewiesene Gäste & Neuer Tisch -->
                <div style="flex: 1; min-width: 300px; max-width: 380px;">
                    <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; padding: 20px; margin-bottom: 25px;">
                        <h4 style="font-size: 1.1rem; color: #fff; margin-bottom: 15px; font-weight: 600;">Unzugewiesene Gäste (@unassignedGuests.Count)</h4>
                        
                        <div id="unassigned-zone" class="table-drop-zone" ondragover="allowDrop(event)" ondragleave="removeDropStyle(event)" ondrop="dropGuest(event, '')" style="min-height: 120px; max-height: 380px; overflow-y: auto; padding-right: 5px; border: 2px dashed rgba(255,255,255,0.1); border-radius: 10px; padding: 10px;">
                            @if (!unassignedGuests.Any())
                            {
                                <p style="color: #64748b; font-size: 0.85rem; text-align: center; margin-top: 20px;">Alle Gäste haben einen Platz! 🎉</p>
                            }
                            @foreach (var guest in unassignedGuests)
                            {
                                <div class="guest-item" draggable="true" ondragstart="drag(event)" data-guest-id="@guest.Id" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; padding: 10px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <strong style="color: #fff; font-size: 0.9rem;">@guest.Name</strong><br />
                                        <small style="color: #94a3b8; font-size: 0.75rem;">Personen: @guest.NumberOfGuests</small>
                                        @if (!string.IsNullOrEmpty(guest.FoodIntolerances) || !string.IsNullOrEmpty(guest.DietaryNotes))
                                        {
                                            <span title="Allergie/Unverträglichkeit vorhanden" style="font-size: 0.7rem; background: rgba(239,68,68,0.2); color:#f87171; padding: 1px 5px; border-radius: 4px; margin-left: 5px;">⚠️ Info</span>
                                        }
                                    </div>
                                    <form asp-action="AssignGuestToTable" method="post" style="margin: 0;">
                                        <input type="hidden" name="guestId" value="@guest.Id" />
                                        <select name="tableId" onchange="this.form.submit()" style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid rgba(255,255,255,0.2); padding: 4px 6px; border-radius: 6px; font-size: 0.8rem;">
                                            <option value="">Tisch...</option>
                                            @foreach (var table in Model)
                                            {
                                                <option value="@table.Id">@table.Name</option>
                                            }
                                        </select>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Neuen Tisch anlegen -->
                    <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; padding: 20px;">
                        <h4 style="font-size: 1.1rem; color: #fff; margin-bottom: 15px; font-weight: 600;">Neuen Tisch erstellen</h4>
                        <form asp-action="AddTable" method="post">
                            @Html.AntiForgeryToken()
                            <div style="margin-bottom: 12px;">
                                <label style="display: block; font-size: 0.85rem; color: #ccc; margin-bottom: 5px;">Tischname</label>
                                <input type="text" name="tableName" required placeholder="z. B. Ehrentisch" style="width: 100%; padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff; font-size: 0.9rem;" />
                            </div>
                            <div style="margin-bottom: 15px;">
                                <label style="display: block; font-size: 0.85rem; color: #ccc; margin-bottom: 5px;">Kapazität</label>
                                <input type="number" name="capacity" value="8" required style="width: 100%; padding: 10px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff; font-size: 0.9rem;" />
                            </div>
                            <button type="submit" class="btn-glow" style="width: 100%; padding: 10px; font-size: 0.9rem; border-radius: 8px; border: none; cursor: pointer;">Tisch hinzufügen</button>
                        </form>
                    </div>
                </div>

                <!-- Rechte Spalte: Tische -->
                <div style="flex: 2; min-width: 320px;">
                    <h4 style="font-size: 1.2rem; color: #fff; margin-bottom: 15px; font-weight: 600;">Tisch-Layout im Raum</h4>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                        @foreach (var table in Model)
                        {
                            var currentOccupancy = table.Guests?.Sum(g => g.NumberOfGuests) ?? 0;
                            var isOverbooked = currentOccupancy > table.Capacity;

                            <div class="table-drop-zone" ondragover="allowDrop(event)" ondragleave="removeDropStyle(event)" ondrop="dropGuest(event, '@table.Id')" style="background: rgba(255, 255, 255, 0.05); border: 2px solid @(isOverbooked ? "rgba(239, 68, 68, 0.6)" : "rgba(255, 255, 255, 0.12)"); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between;">
                                
                                <div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 10px;">
                                        <h5 style="color: #f472b6; margin: 0; font-size: 1.1rem; font-family: 'Playfair Display', serif;">@table.Name</h5>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span style="font-size: 0.8rem; background: @(isOverbooked ? "rgba(239,68,68,0.2)" : "rgba(244,114,182,0.15)"); color: @(isOverbooked ? "#f87171" : "#ff9cf2"); padding: 3px 8px; border-radius: 12px; border: 1px solid @(isOverbooked ? "rgba(239,68,68,0.4)" : "rgba(244,114,182,0.3)");">
                                                @currentOccupancy / @table.Capacity P.
                                            </span>
                                            <form asp-action="DeleteTable" method="post" style="margin: 0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@table.Id" />
                                                <button type="submit" onclick="return confirm('Tisch wirklich löschen?')" title="Tisch löschen" style="background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; width: 24px; height: 24px; border-radius: 50%; cursor: pointer; font-size: 0.75rem; display: flex; align-items: center; justify-content: center;">×</button>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Gäste am Tisch -->
                                    <div style="min-height: 80px; margin-bottom: 10px;">
                                        @if (table.Guests != null && table.Guests.Any())
                                        {
                                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                                @foreach (var guest in table.Guests)
                                                {
                                                    <div class="guest-item" draggable="true" ondragstart="drag(event)" data-guest-id="@guest.Id" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); padding: 5px 10px; border-radius: 8px; font-size: 0.85rem; display: flex; align-items: center; gap: 6px; color: #fff;">
                                                        <span>@guest.Name <span style="color: #aaa; font-size: 0.75rem;">(@guest.NumberOfGuests P.)</span></span>
                                                        <form asp-action="AssignGuestToTable" method="post" style="margin: 0; display: inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="guestId" value="@guest.Id" />
                                                            <input type="hidden" name="tableId" value="" />
                                                            <button type="submit" title="Vom Tisch entfernen" style="background: none; border: none; color: #f87171; cursor: pointer; font-size: 0.9rem; padding: 0; line-height: 1;">×</button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p style="color: #64748b; font-size: 0.85rem; font-style: italic; margin: 5px 0;">Tisch ist noch leer.</p>
                                        }
                                    </div>
                                </div>

                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Drag & Drop JavaScript -->
    <script>
        function allowDrop(ev) {
            ev.preventDefault();
            let zone = ev.currentTarget;
            zone.classList.add('drag-over');
        }

        function removeDropStyle(ev) {
            let zone = ev.currentTarget;
            zone.classList.remove('drag-over');
        }

        function drag(ev) {
            let guestId = ev.currentTarget.getAttribute('data-guest-id');
            ev.dataTransfer.setData("text/plain", guestId);
        }

        function dropGuest(ev, tableId) {
            ev.preventDefault();
            let zone = ev.currentTarget;
            zone.classList.remove('drag-over');

            let guestId = ev.dataTransfer.getData("text/plain");
            if (!guestId) return;

            let form = document.createElement('form');
            form.method = 'post';
            form.action = '/Home/AssignGuestToTable';

            // Anti-Forgery-Token aus einem bestehenden Formular im Dokument holen falls vorhanden
            let tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) {
                let tokenClone = tokenInput.cloneNode(true);
                form.appendChild(tokenClone);
            }

            let inputGuest = document.createElement('input');
            inputGuest.type = 'hidden';
            inputGuest.name = 'guestId';
            inputGuest.value = guestId;
            form.appendChild(inputGuest);

            let inputTable = document.createElement('input');
            inputTable.type = 'hidden';
            inputTable.name = 'tableId';
            inputTable.value = tableId; 
            form.appendChild(inputTable);

            document.body.appendChild(form);
            form.submit();
        }
    </script>
</body>
</html>