@model IEnumerable<TooTheMoon.Models.WeddingTable>

@{
    ViewData["Title"] = "Sitzplan verwalten";
    var attendingGuests = ViewBag.AttendingGuests as List<TooTheMoon.Models.RsvpGuest> ?? new List<TooTheMoon.Models.RsvpGuest>();
}

<div class="container mt-4">
    <h2>Sitzplan verwalten</h2>
    <hr />

    <div class="row">
        <!-- Linke Spalte: Alle zugesagten Gäste noch ohne Tisch -->
        <div class="col-md-4">
            <h4>Zugesagte Gäste</h4>
            <div class="list-group mb-4" style="max-height: 500px; overflow-y: auto;">
                @foreach (var guest in attendingGuests.Where(g => g.WeddingTableId == null))
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@guest.Name</strong>
                            <br /><small class="text-muted">Personen: @guest.NumberOfGuests</small>
                        </div>
                        <form asp-action="AssignGuestToTable" method="post" class="d-inline">
                            <input type="hidden" name="guestId" value="@guest.Id" />
                            <select name="tableId" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                <option value="">Tisch wählen...</option>
                                @foreach (var table in Model)
                                {
                                    <option value="@table.Id">@table.Name</option>
                                }
                            </select>
                        </form>
                    </div>
                }
            </div>

            <!-- Neuen Tisch anlegen -->
            <div class="card p-3 bg-light">
                <h5>Neuen Tisch erstellen</h5>
                <form asp-action="AddTable" method="post">
                    <div class="mb-2">
                        <label class="form-label">Tischname</label>
                        <input type="text" name="tableName" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Kapazität</label>
                        <input type="number" name="capacity" class="form-control" value="8" required />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Tisch hinzufügen</button>
                </form>
            </div>
        </div>

        <!-- Rechte Spalte: Tische und zugewiesene Gäste -->
        <div class="col-md-8">
            <h4>Tische</h4>
            <div class="row">
                @foreach (var table in Model)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header d-flex justify-content-between align-items-center bg-secondary text-white">
                                <strong>@table.Name</strong>
                                <span>(Plätze: @(table.Guests?.Sum(g => g.NumberOfGuests) ?? 0) / @table.Capacity)</span>
                                <form asp-action="DeleteTable" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@table.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Tisch wirklich löschen?')">X</button>
                                </form>
                            </div>
                            <div class="card-body">
                                @if (table.Guests != null && table.Guests.Any())
                                {
                                    <ul class="list-group">
                                        @foreach (var guest in table.Guests)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center py-1">
                                                <span>@guest.Name (@guest.NumberOfGuests P.)</span>
                                                <form asp-action="AssignGuestToTable" method="post" class="d-inline">
                                                    <input type="hidden" name="guestId" value="@guest.Id" />
                                                    <input type="hidden" name="tableId" value="" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-1" title="Vom Tisch entfernen">×</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">Noch keine Gäste zugewiesen.</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>