                <!-- Heike -->
                <div style="flex: 1; min-width: 300px; max-width: 400px;">
                    <div style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; padding: 30px; height: 100%; text-align: center;">
                        
                        <div style="width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 20px auto; overflow: hidden; border: 2px solid rgba(244, 114, 182, 0.5);">
                            <img src="~/images/Heike1.jpg" alt="Heike" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>

                        <h3 style="font-family: 'Playfair Display', serif; color: #ffffff; font-size: 1.4rem; margin-bottom: 5px;">Heike</h3>
                        <span style="color: #f472b6; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 15px; font-weight: bold;">Trauzeugin von Andrea</span>
                        
                        <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">
                            „Bodenstation für Andrea: Behält den Überblick, wenn die Emotionen abheben.“
                        </p>

                        <div style="margin-top: 15px; background: rgba(244, 114, 182, 0.15); padding: 10px 20px; border-radius: 25px; display: inline-block; border: 1px solid rgba(244, 114, 182, 0.3);">
                            <a href="tel:01763234430" style="color: #ff9cf2 !important; text-decoration: none; font-size: 1.1rem; font-weight: bold;">
                                📞 0176 3234430
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Lulu -->
                <div style="flex: 1; min-width: 300px; max-width: 400px;">
                    <div style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; padding: 30px; height: 100%; text-align: center;">
                        
                        <div style="width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 20px auto; overflow: hidden; border: 2px solid rgba(192, 132, 252, 0.5);">
                            <img src="~/images/Lulu3.jpg" alt="Lulu" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>

                        <h3 style="font-family: 'Playfair Display', serif; color: #ffffff; font-size: 1.4rem; margin-bottom: 5px;">Lulu</h3>
                        <span style="color: #c084fc; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 15px; font-weight: bold;">Trauzeugin von Katja</span>
                        
                        <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">
                             „Co-Pilotin für Katja: Reicht das Taschentuch, wenn der Freudenjubel startet.“
                        </p>

                        <div style="margin-top: 15px; background: rgba(192, 132, 252, 0.15); padding: 10px 20px; border-radius: 25px; display: inline-block; border: 1px solid rgba(192, 132, 252, 0.3);">
                            <a href="tel:017232359430" style="color: #e879f9 !important; text-decoration: none; font-size: 1.1rem; font-weight: bold;">
                                📞 0172 32359430
                            </a>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Überschrift und Einleitungstext unten -->
            <div style="text-align: center; margin-top: 40px;">
                <h2 class="section-title" style="margin-bottom: 10px;">Unsere Trauzeugen</h2>
                <div class="section-subtitle">„Unsere Co-Pilotinnen für die Reise zum Mond und zurück. Kontaktiert sie für geheime Missionen:“</div>
            </div>

        </div>
    </section>

    <section id="rsvp">
        <div class="glass-panel content-box">
            <h2 class="section-title">Seid ihr dabei?</h2>
            <div class="section-subtitle">Bitte teilt uns bis zum Anmeldeschluss mit, ob ihr an unserem großen Tag dabei sein könnt.</div>

            <form action="/Home/SubmitRsvp" method="post">
                @Html.AntiForgeryToken()
                
                <div class="form-group">
                    <label class="form-label">Nimmst du teil? *</label>
                    <div class="attendance-options">
                        <label class="attendance-option">
                            <input type="radio" name="Attending" value="Ja" checked>
                            <div class="attendance-card">✓ Ja</div>
                        </label>
                        <label class="attendance-option">
                            <input type="radio" name="Attending" value="Nein">
                            <div class="attendance-card">✕ Nein</div>
                        </label>
                        <label class="attendance-option">
                            <input type="radio" name="Attending" value="Vielleicht">
                            <div class="attendance-card">⏱ Vielleicht</div>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label for="name" class="form-label">Name *</label>
                    <input type="text" id="name" name="Name" required placeholder="Dein vollständiger Name">
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">E-Mail</label>
                    <input type="email" id="email" name="Email" placeholder="deine@email.de">
                </div>

                <label class="checkbox-label" style="display: block; margin-bottom: 15px;">
                    <input type="checkbox" name="HasCompanion" value="true"> Ich bringe eine Begleitung mit
                </label>

                <div class="form-group">
                    <label for="children" class="form-label">Kinder</label>
                    <select id="children" name="Children">
                        <option value="Keine Kinder" selected>Keine Kinder</option>
                        <option value="1 Kind">1 Kind</option>
                        <option value="2 Kinder">2 Kinder</option>
                        <option value="3+ Kinder">3 oder mehr Kinder</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="display: block; margin-bottom: 8px; font-weight: bold; color: #fff;">Catering / Ernährungs-Anzahl (für alle Personen)</label>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px;">
                        <div>
                            <label style="font-size: 0.85rem; color: #aaa; display: block; margin-bottom: 4px;">Allesesser</label>
                            <input type="number" name="MeatCount" value="1" min="0" max="20" style="width: 100%; padding: 12px 16px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; color: #fff; font-size: 14px;" />
                        </div>
                        <div>
                            <label style="font-size: 0.85rem; color: #aaa; display: block; margin-bottom: 4px;">Vegetarisch</label>
                            <input type="number" name="VeggieCount" value="0" min="0" max="20" style="width: 100%; padding: 12px 16px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; color: #fff; font-size: 14px;" />
                        </div>
                        <div>
                            <label style="font-size: 0.85rem; color: #aaa; display: block; margin-bottom: 4px;">Vegan</label>
                            <input type="number" name="VeganCount" value="0" min="0" max="20" style="width: 100%; padding: 12px 16px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; color: #fff; font-size: 14px;" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="intolerances" class="form-label">Allergien / Unverträglichkeiten</label>
                    <input type="text" id="intolerances" name="FoodIntolerances" placeholder="z. B. Gluten, Laktose, Nüsse...">
                </div>

                <div class="form-group">
                    <label for="song" class="form-label">Musikwunsch</label>
                    <input type="text" id="song" name="SongRequest" placeholder="Bei welchem Song stürmst du die Tanzfläche?">
                </div>

                <div class="form-group">
                    <label for="message" class="form-label">Nachricht an das Brautpaar</label>
                    <textarea id="message" name="MessageToCouple" rows="3" placeholder="Eure Wünsche oder Anmerkungen..."></textarea>
                </div>

                <button type="submit" class="btn-glow" style="width: 100%; margin-top: 10px;">Zusage absenden</button>
            </form>
        </div>
    </section>

    <section id="faq" class="container my-5">
        <div class="glass-panel" style="max-width: 800px; margin: 0 auto; padding: 30px;">
            <h2 class="section-title text-center">Häufige Fragen (FAQ)</h2>
            <div class="section-subtitle text-center mb-4">Alles, was ihr für unseren großen Tag wissen müsst</div>

            <div class="faq-container">
                <div class="faq-item">
                    <div class="faq-question">Was ist der Dresscode?</div>
                    <div class="faq-answer">
                         Zieht an, worin ihr euch wohlfühlt und exzessiv das Tanzbein schwingen könnt! Einziger Haken: Bitte keine Jogginghose – es sei denn, sie glitzert im Sternenlicht. 😉
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">Gibt es Parkplätze vor Ort?</div>
                    <div class="faq-answer">
                        Ja, direkt an der Location gibt es ausreichend Parkmöglichkeiten für alle anreisenden Gäste.
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">Sind Kinder willkommen?</div>
                    <div class="faq-answer">
                       Ja, Kinder sind herzlich willkommen! Bitte gebt bei der Anmeldung an, ob ihr Kinder mitbringt, damit wir entsprechend planen können.
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">Was wünscht ihr euch als Geschenk?</div>
                    <div class="faq-answer">
                        Eure Anwesenheit ist das schönste Geschenk für uns! Wer uns dennoch eine Freude machen möchte, kann gerne unseren Flitterwochen-Fonds für gemeinsame Abenteuer unterstützen.
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">Kann ich jemanden mitbringen?</div>
                    <div class="faq-answer">
                        Da unsere Kapazitäten begrenzt sind, gilt die Einladung namentlich für die auf der Karte genannten Personen. Falls ihr dazu Fragen habt, sprecht uns einfach an.
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">Bis wann muss ich mich anmelden?</div>
                    <div class="faq-answer">
                        Bitte gebt uns über das RSVP-Formular bis zum eingetragenen Stichtag Bescheid, ob ihr dabei sein könnt.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- JavaScript -->
    <script>
        function triggerPortalExplosion() {
            const overlay = document.getElementById('curtainOverlay');
            overlay.classList.add('open');
            setTimeout(() => {
                overlay.classList.add('hidden');
            }, 800);
        }

        const weddingDate = new Date("August 14, 2027 13:30:00").getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = weddingDate - now;

            if (distance < 0) {
                document.getElementById("countdown").innerHTML = "Der große Tag ist da!";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            const countdownElement = document.getElementById("countdown");
            if (countdownElement) {
                countdownElement.innerHTML = 
                    `<span>${days}</span> Tage &nbsp;·&nbsp; <span>${hours}</span> Std &nbsp;·&nbsp; <span>${minutes}</span> Min &nbsp;·&nbsp; <span>${seconds}</span> Sek`;
            }
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        document.addEventListener("DOMContentLoaded", function () {
            const questions = document.querySelectorAll('.faq-question');
            
            questions.forEach(question => {
                question.addEventListener('click', () => {
                    const item = question.parentElement;
                    const isActive = item.classList.contains('active');
                    
                    document.querySelectorAll('.faq-item').forEach(el => {
                        el.classList.remove('active');
                    });

                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });
        });

        function toggleMusic() {
            const music = document.getElementById("bg-music");
            const icon = document.getElementById("music-icon");
            const text = document.getElementById("music-text");

            if (music.paused) {
                music.play().catch(error => {
                    console.log("Autoplay wurde vom Browser blockiert.", error);
                });
                icon.textContent = "🎵";
                text.textContent = "Musik läuft";
            } else {
                music.pause();
                icon.textContent = "🔇";
                text.textContent = "Musik aus";
            }
        }
    </script>
</body>
</html>