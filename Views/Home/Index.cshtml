            <div class="hero-image">
                <img src="~/images/wir.jpg" alt="Andrea & Katja" />
            </div>
            <div class="hero-content">
                <div class="moon-intro-badge">
                    <p>„To the Moon and back – unsere Reise, unser Tag.“</p>
                </div>

                <div class="subtitle-top">Wir heiraten!</div>
                <h1>Andrea & Katja</h1>
                <div class="invitation-text">Wir laden euch von Herzen ein ❤️</div>

                <div class="countdown" id="countdown">
                    Lade Countdown...
                </div>

                <div class="wedding-date">14. August 2027</div>
                <div class="wedding-location">Königshof Erwitte & Sprikeltrix</div>

                <a href="#rsvp" class="btn-glow">Jetzt zusagen</a>
            </div>
