@{
    ViewData["Title"] = "Andrea & Katja – Unsere Hochzeit";
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" />
</head> 

<body>

    <div class="side-stars-container">
        <div class="star star-1"></div>
        <div class="star star-2"></div>
        <div class="star star-3"></div>
        <div class="star star-4"></div>
        <div class="star star-5"></div>
        <div class="star star-6"></div>
        <div class="star star-7"></div>
        <div class="shooting-star"></div>
    </div>

    <div class="curtain-overlay" id="curtainOverlay">
        <div class="light-flash"></div>
        <div class="curtain-content">
            <div class="curtain-subtitle">Andrea & Katja laden euch ein</div>
            
            <div class="moon-portal-wrapper" onclick="triggerPortalExplosion()" title="Portal öffnen">
                <div class="portal-star portal-star-1"></div>
                <div class="portal-star portal-star-2"></div>
                <div class="portal-star portal-star-3"></div>
                <div class="portal-star portal-star-4"></div>

                <svg width="280" height="280" viewBox="0 0 200 200" class="moon-portal-svg">
                    <defs>
                        <linearGradient id="portalGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="rgba(255, 255, 255, 0.07)" />
                            <stop offset="100%" stop-color="rgba(255, 255, 255, 0.02)" />
                        </linearGradient>
                    </defs>
                    <path d="M 110 10 A 90 90 0 1 0 190 130 A 75 75 0 1 1 110 10 Z" 
                        fill="url(#portalGradient)" 
                        stroke="rgba(255, 255, 255, 0.15)" 
                        stroke-width="1.5" />
                </svg>
              <div class="portal-initials">Andrea<br>&<br>Katja</div>
            </div>

            <div class="portal-instruction">✨ Portal betreten</div>
        </div>
    </div>

    <div class="aurora-bg">
        <div class="aurora-blob blob-1"></div>
        <div class="aurora-blob blob-2"></div>
        <div class="aurora-blob blob-3"></div>
    </div>

    <header>
        <a href="#home" class="logo">Andrea & Katja</a>
        <nav>
            <a href="#home">Start</a>
            <a href="#schedule">Ablauf</a>
            <a href="#witnesses">Trauzeugen</a>
            <a href="#rsvp">Zusage</a>
            <a href="#faq">FAQ</a>
            <a asp-controller="Home" asp-action="AdminGuests">Admin</a>
        </nav>
    </header>

    <!-- Musik-Player Leiste -->
    <div class="music-player-bar">
        <audio id="bg-music" loop>
            <source src="~/audio/Bis zum letzten Planeten(2).mp3" type="audio/mpeg">
            Dein Browser unterstützt kein Audio-Element.
        </audio>
        
        <button id="music-toggle-btn" class="btn-music-toggle" onclick="toggleMusic()">
            <span id="music-icon">🔇</span> 
            <span id="music-text">Musik ab</span>
        </button>
    </div>

    <section id="home">
