@{
    ViewData["Title"] = "Zusage & RSVP – Andrea & Katja";
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ffffff;
            overflow-y: auto;
        }

        .rsvp-card {
            background: #111827;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 600px;
            padding: 40px;
            margin: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .back-link {
            display: inline-block;
            color: #94a3b8;
            text-decoration: none;
            font-size: 13px;
            margin-bottom: 20px;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #ffffff;
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 700;
            margin: 0 0 8px 0;
            text-align: center;
        }

        .subtitle {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 15px;
            color: #94a3b8;
            text-align: center;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: #cbd5e1;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        input[type="text"],
        input[type="email"],
        input[type="number"],
        select,
        textarea {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

        input:focus, select:focus, textarea:focus {
            border-color: #d4a373;
        }

        select option {
            background: #111827;
            color: #ffffff;
        }

        .radio-group {
            display: flex;
            gap: 20px;
            margin-top: 8px;
        }

        .radio-label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-weight: 400;
            color: #ffffff;
        }

        input[type="radio"] {
            accent-color: #d4a373;
            width: 18px;
            height: 18px;
        }

        .btn-submit {
            display: block;
            width: 100%;
            background: #d4a373;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 500;
            padding: 14px;
            border-radius: 30px;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(212, 163, 115, 0.4);
            transition: background 0.3s ease, transform 0.2s ease;
            margin-top: 30px;
            text-align: center;
        }

        .btn-submit:hover {
            background: #bc8a5d;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

   <div class="rsvp-card">
        <a href="/Home/Index" class="back-link">← Zurück zur Startseite</a>
        
        <h1>Gästebuch & Zusage</h1>
        <div class="subtitle">
            Bitte gib uns bis zum 01. Juli 2027 Bescheid.<br>
            <span style="font-size: 13px; font-weight: 300;">Neugierig auf den Ablauf? Schau dir hier den <a href="/Home/Schedule" style="color: #fef08a; text-decoration: underline;">Zeitplan für den 14. August</a> an.</span>
        </div>

        <form action="/Home/SubmitRsvp" method="post">

            <!-- Name des Hauptgastes -->
            <div class="form-group">
                <label for="name">Dein Name / Vor- und Nachname</label>
                <input type="text" id="name" name="name" required placeholder="Max Mustermann">
            </div>

            <div class="form-group">
                <label for="email">E-Mail-Adresse</label>
                <input type="email" id="email" name="email" required placeholder="name@beispiel.de">
            </div>

            <div class="form-group">
                <label>Seid ihr dabei?</label>
                <div class="radio-group">
                    <label class="radio-label">
                        <input type="radio" name="attending" value="Ja" checked> Ja, wir feiern mit! 🎉
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="attending" value="Nein"> Leider nein 😢
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label for="children">Kinder (optional)</label>
                <select id="children" name="children">
                    <option value="Keine Kinder" selected>Keine Kinder</option>
                    <option value="1 Kind">1 Kind</option>
                    <option value="2 Kinder">2 Kinder</option>
                    <option value="3+ Kinder">3+ Kinder</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: bold; color: #fff;">Catering / Ernährungs-Anzahl (für alle Personen)</label>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px;">
                    <div>
                        <label style="font-size: 0.85rem; color: #aaa; display: block; margin-bottom: 4px;">Allesesser</label>
                        <input type="number" name="meatCount" value="1" min="0" max="20" />
                    </div>
                    <div>
                        <label style="font-size: 0.85rem; color: #aaa; display: block; margin-bottom: 4px;">Vegetarisch</label>
                        <input type="number" name="veggieCount" value="0" min="0" max="20" />
                    </div>
                    <div>
                        <label style="font-size: 0.85rem; color: #aaa; display: block; margin-bottom: 4px;">Vegan</label>
                        <input type="number" name="veganCount" value="0" min="0" max="20" />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-submit">Zusage abschicken</button>
        </form>
    </div>

</body>
</html>