@{
    ViewData["Title"] = "Ablauf & Zeitplan – Andrea & Katja";
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ffffff;
            overflow-y: auto;
        }

        .schedule-card {
            background: #111827;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 650px;
            padding: 40px;
            margin: 30px 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .back-link {
            display: inline-block;
            color: #94a3b8;
            text-decoration: none;
            font-size: 13px;
            margin-bottom: 20px;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #ffffff;
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 700;
            margin: 0 0 8px 0;
            text-align: center;
        }

        .subtitle {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: 15px;
            color: #94a3b8;
            text-align: center;
            margin-bottom: 35px;
        }

        /* Timeline-Design */
        .timeline {
            position: relative;
            padding-left: 30px;
            border-left: 2px solid rgba(212, 163, 115, 0.4);
            margin-left: 10px;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 30px;
        }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        /* Der Punkt auf der Timeline-Linie */
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -36px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #d4a373;
            border: 2px solid #111827;
        }

        .timeline-time {
            font-size: 13px;
            font-weight: 600;
            color: #fef08a;
            letter-spacing: 1px;
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .timeline-title {
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .timeline-desc {
            font-size: 14px;
            color: #cbd5e1;
            line-height: 1.5;
        }

        .location-note {
            margin-top: 40px;
            text-align: center;
            font-size: 13px;
            color: #94a3b8;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding-top: 20px;
        }
    </style>
</head>
<body>

    <div class="schedule-card">
        <a href="/Home/Index" class="back-link">← Zurück zur Startseite</a>
        
        <h1>Ablauf des Tages</h1>
        <div class="subtitle">14. August 2027 – Schloss Erwitte</div>

        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-time">13:30 Uhr</div>
                <div class="timeline-title">Eintreffen der Gäste</div>
                <div class="timeline-desc">Ankunft im Schloss Erwitte und Einnahme der Plätze für die Zeremonie.</div>
            </div>

            <div class="timeline-item">
                <div class="timeline-time">14:00 Uhr</div>
                <div class="timeline-title">Trauung</div>
                <div class="timeline-desc">Der gemeinsame Start in unser neues Kapitel – Augenblicke voller Emotionen.</div>
            </div>

            <div class="timeline-item">
                <div class="timeline-time">15:15 Uhr</div>
                <div class="timeline-title">Sektempfang & Gratulation</div>
                <div class="timeline-desc">Anstoßen im Schlosshof, erste Gespräche und gemeinsame Erinnerungsfotos.</div>
            </div>

            <div class="timeline-item">
                <div class="timeline-time">18:00 Uhr</div>
                <div class="timeline-title">Eröffnung des Abendessens</div>
                <div class="timeline-desc">Genussvolles Beisammensein, gutes Essen und emotionale Reden im Festsaal.</div>
            </div>

            <div class="timeline-item">
                <div class="timeline-time">21:30 Uhr</div>
                <div class="timeline-title">Eröffnungstanz & Party</div>
                <div class="timeline-desc">Der erste Tanz als Ehepaar und anschließende Party bis in die frühen Morgenstunden! 🎶</div>
            </div>
        </div>

        <div class="location-note">
            📍 Alle Programmpunkte finden direkt vor Ort auf Schloss Erwitte statt.
        </div>
    </div>

</body>
</html>