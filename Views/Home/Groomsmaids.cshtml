@{
    ViewData["Title"] = "Unsere Trauzeugen";
}

<div style="background-color: #0f172a; color: #fff; min-height: 85vh; padding: 40px 20px; border-radius: 16px; margin: 20px 0;">
    <div class="container" style="max-width: 900px;">
        
        <div class="text-center mb-5">
            <h2 style="font-family: 'Playfair Display', serif; color: #f472b6; font-size: 2.2rem; margin-bottom: 10px;">Unsere Trauzeugen</h2>
            <p style="color: #94a3b8; font-size: 1.05rem;">Die wichtigsten Menschen an unserer Seite – neben Nuts und Urmel natürlich! 🐾</p>
        </div>

        <div class="row g-4">
            <!-- Trauzeuge 1 -->
            <div class="col-md-6">
                <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 30px; height: 100%; text-align: center;">
                    <div style="width: 100px; height: 100px; background: rgba(244, 114, 182, 0.1); border-radius: 50%; margin: 0 auto 20px auto; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; border: 2px solid rgba(244, 114, 182, 0.3);">
                        👩‍💻
                    </div>
                    <h3 style="font-family: 'Playfair Display', serif; color: #fff; font-size: 1.4rem; margin-bottom: 5px;">Name Person 1</h3>
                    <span style="color: #f472b6; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 15px;">Die Chaos-Koordinatorin</span>
                    <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6;">
                        Hier ein paar nette Worte darüber, wer die Person ist, woher ihr euch kennt und warum sie an diesem Tag unverzichtbar ist.
                    </p>
                </div>
            </div>

            <!-- Trauzeuge 2 -->
            <div class="col-md-6">
                <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 30px; height: 100%; text-align: center;">
                    <div style="width: 100px; height: 100px; background: rgba(96, 165, 250, 0.1); border-radius: 50%; margin: 0 auto 20px auto; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; border: 2px solid rgba(96, 165, 250, 0.3);">
                        ✨
                    </div>
                    <h3 style="font-family: 'Playfair Display', serif; color: #fff; font-size: 1.4rem; margin-bottom: 5px;">Name Person 2</h3>
                    <span style="color: #60a5fa; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 15px;">Der Ruhepol</span>
                    <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6;">
                        Hier steht ebenfalls eine kurze, schöne Beschreibung über die zweite wichtige Person.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>